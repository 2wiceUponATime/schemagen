{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Person",
  "$defs": {
    "Age": {
      "type": "integer",
      "minimum": 0,
      "maximum": 150
    },
    "Email": {
      "type": "string",
      "format": "email",
      "description": "an email address"
    },
    "Person": {
      "type": "object",
      "properties": {
        "email": {
          "$ref": "#/$defs/Email"
        },
        "age": {
          "$ref": "#/$defs/Age"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "required": [
        "email",
        "age",
        "tags"
      ],
      "additionalProperties": true,
      "title": "Person"
    }
  }
}
