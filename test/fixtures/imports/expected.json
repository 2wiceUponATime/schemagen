{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Segment",
  "$defs": {
    "Point": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "Segment": {
      "type": "object",
      "properties": {
        "head": {
          "$ref": "#/$defs/Point"
        },
        "tail": {
          "$ref": "#/$defs/Point"
        },
        "meta": {
          "$ref": "#/$defs/default"
        }
      },
      "required": [
        "head",
        "tail",
        "meta"
      ],
      "additionalProperties": false
    },
    "default": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "generator": {
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "generator"
      ],
      "additionalProperties": false
    }
  }
}
