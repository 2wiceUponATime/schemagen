{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Config",
  "$defs": {
    "Config": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "quoted-key": {
          "type": "integer"
        }
      },
      "required": [
        "name",
        "quoted-key"
      ],
      "additionalProperties": {
        "type": "boolean"
      }
    }
  }
}
