    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Compile File",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "runtimeExecutable": "pnpm",
            "runtimeArgs": ["dev:debug", "${file}"],
            "outFiles": [
                "${workspaceFolder}/**/*.js"
            ]
        }
    ]
}